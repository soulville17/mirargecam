{
  "appId": "com.miragecam.desktop",
  "productName": "MirageCam",
  "copyright": "Copyright © 2024 MirageCam",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "public/**/*",
    "package.json",
    "!**/*.map"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "asar": true,
  "mac": {
    "category": "public.app-category.video",
    "icon": "public/icons/icon.jpg",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "NSCameraUsageDescription": "MirageCam needs camera access for real-time face transformation",
      "NSMicrophoneUsageDescription": "MirageCam needs microphone access for video calls"
    }
  },
  "dmg": {
    "title": "MirageCam Installer",
    "icon": "public/icons/icon.jpg",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "icon": "public/icons/icon.jpg",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "publisherName": "MirageCam",
    "legalTrademarks": "MirageCam - Face Swap en Temps Reel"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MirageCam",
    "uninstallDisplayName": "MirageCam",
    "installerLanguages": ["fr", "en"],
    "language": "1036"
  },
  "linux": {
    "icon": "public/icons",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Video",
    "maintainer": "MirageCam <support@miragecam.com>",
    "desktop": {
      "Name": "MirageCam",
      "Comment": "Face Swap en Temps Reel",
      "Keywords": "face;swap;video;camera"
    }
  },
  "publish": {
    "provider": "github",
    "owner": "soulville17",
    "repo": "mirargecam"
  }
}
